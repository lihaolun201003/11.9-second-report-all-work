def authors_str(d):
    au = d.get('authors') or []
    if not au:
        return ""
    def fmt(a):
        parts = a.split()
        if len(parts) <= 1:
            return a
        # initials for given names
        given = parts[:-1]
        fam = parts[-1]
        ini = " ".join(p[0] + "." for p in given if p)
        return fam + " " + ini
    if len(au) > 6:
        return ", ".join(fmt(a) for a in au[:6]) + " et al."
    return ", ".join(fmt(a) for a in au)

entries = []

def add(key, doi, verified, note, access="2026-10-28", fulltext_label="摘要"):
    d = v.get(doi, {})
    entries.append({
        "key": key,
        "authors": authors_str(d),
        "title": (d.get('title') or '').replace('&amp;', '&'),
        "venue": d.get('container') or '',
        "year": d.get('year'),
        "doi": doi,
        "url": "https://doi.org/" + doi if doi else "",
        "verified": verified,
        "access": access,
        "note": note + ("；获取状态：" + fulltext_label if fulltext_label else "")
    })

